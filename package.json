{
  "name": "monikadvorackova.net",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "postinstall": "node scripts/check-native-deps.js",
    "dev": "next dev",
    "dev:reset": "rm -rf .next && next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:agent": "node --import tsx --test tests/agent/*.test.ts",
    "test:e2e": "playwright test",
    "agent:sync": "node --import tsx scripts/agent-sync.ts",
    "agent:index": "node --import tsx scripts/agent-index.ts",
    "agent:migrate": "node --import tsx scripts/agent-migrate.ts",
    "agent:maintenance": "node --import tsx scripts/agent-maintenance.ts",
    "prebuild": "node --import tsx scripts/agent-content.ts && node --import tsx scripts/agent-index.ts --if-configured",
    "predev": "node --import tsx scripts/agent-content.ts",
    "agent:revalidate": "node --import tsx scripts/agent-revalidate.ts",
    "agent:deliver": "node --import tsx scripts/agent-deliver.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@next/mdx": "15.5.29",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.525.0",
    "mermaid": "^11.13.0",
    "next": "15.5.29",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@twemoji/svg": "^15.0.0",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "next": "15.5.29",
    "postcss": "8.5.32",
    "brace-expansion": "1.1.21",
    "postcss-selector-parser": "6.1.5"
  }
}
