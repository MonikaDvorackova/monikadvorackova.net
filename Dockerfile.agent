FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY scripts/check-native-deps.js scripts/check-native-deps.js
RUN npm ci
COPY . .
RUN npm run build
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
RUN addgroup -S agent && adduser -S agent -G agent
COPY --from=build --chown=agent:agent /app/.next/standalone ./
COPY --from=build --chown=agent:agent /app/.next/static ./.next/static
COPY --from=build --chown=agent:agent /app/public ./public
COPY --from=build --chown=agent:agent /app/posts ./posts
COPY --from=build --chown=agent:agent /app/content ./content
COPY --from=build --chown=agent:agent /app/data ./data
USER agent
EXPOSE 3000
CMD ["node","server.js"]
